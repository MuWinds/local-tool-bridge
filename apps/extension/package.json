{
  "name": "@dlb/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 extension that gives the AI web app access to local tools.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "zip": "node build.mjs --zip"
  },
  "dependencies": {
    "@dlb/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
